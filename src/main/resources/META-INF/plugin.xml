<idea-plugin>
    <id>local.tether</id>
    <name>Tether for coding agents</name>
    <vendor url="https://github.com/atlipall/tether">Atli Páll Hafsteinsson</vendor>
    <description><![CDATA[
    Native chat panel for coding agents: the Claude Code CLI and Agent Client Protocol agents
    such as Hermes. Runs the locally installed agents with their existing logins, links files
    the agent touches, shows diffs of its edits, and tells it about files you edited between turns.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>com.intellij.modules.vcs</depends>
    <!-- TypeScript service errors for the diagnostics tool; the plugin works without it. -->
    <depends optional="true" config-file="tether-javascript.xml">JavaScript</depends>
    <!-- "Send Failures to Tether" in the test runner. -->
    <depends optional="true" config-file="tether-tests.xml">intellij.testRunner.plugin</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="local.tether.problemSource" interface="tether.ide.tools.ProblemSource" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools" id="tether.settings" displayName="Tether"
                                 instance="tether.settings.TetherConfigurable"/>
        <toolWindow id="Tether" anchor="right" icon="/icons/tether.svg"
                    canCloseContents="true" factoryClass="tether.ui.ChatToolWindowFactory"/>
        <notificationGroup id="Tether" displayType="STICKY_BALLOON"/>
        <errorHandler implementation="tether.report.TetherErrorReporter"/>
        <intentionAction>
            <language/>
            <className>tether.ide.FixWithTether</className>
            <category>Tether</category>
        </intentionAction>
    </extensions>

    <actions>
        <action id="tether.AddToChat" class="tether.ide.AddToChatAction"
                text="Add to Tether" description="Insert a reference to this file or selection into the Tether chat">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift alt K"/>
        </action>
        <action id="tether.RenameChat" class="tether.ui.RenameChatAction"
                text="Rename Chat…" description="Give this Tether chat a name (saved with its session)">
            <add-to-group group-id="ToolWindowContextMenu" anchor="last"/>
        </action>
        <action id="tether.ArchiveChat" class="tether.ui.ArchiveChatAction"
                text="Archive Chat" description="Close this Tether chat and move its session to Archived sessions">
            <add-to-group group-id="ToolWindowContextMenu" anchor="after" relative-to-action="tether.RenameChat"/>
        </action>
        <action id="tether.ArchiveAllSessions" class="tether.ui.ArchiveAllSessionsAction"
                text="Archive All Past Sessions…" description="Move every past session of this project and its worktrees to Archived sessions (open chats are left alone)">
            <add-to-group group-id="ToolWindowContextMenu" anchor="after" relative-to-action="tether.ArchiveChat"/>
        </action>
        <action id="tether.SendConsoleToTether" class="tether.ide.SendConsoleToTether"
                text="Send to Tether" description="Put the selected console output (or all of it) into the Tether chat">
            <add-to-group group-id="ConsoleView.PopupMenu" anchor="last"/>
        </action>
        <action id="tether.ReportBug" class="tether.report.ReportBugAction"
                text="Report a Tether Bug…" description="Open a new Tether issue on GitHub with versions and Tether's recent log filled in">
            <add-to-group group-id="HelpMenu" anchor="after" relative-to-action="ReportProblem"/>
        </action>
    </actions>
</idea-plugin>
